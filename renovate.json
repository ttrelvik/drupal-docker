{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "php"
      ],
      "allowedVersions": "< 8.5.0"
    },
    {
      "matchManagers": [
        "composer"
      ],
      "groupName": "Composer Suite",
      "groupSlug": "composer-packages"
    }
  ]
}